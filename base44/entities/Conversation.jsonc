{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "participant_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of both participants"
    },
    "participant_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_message": {
      "type": "string"
    },
    "last_message_date": {
      "type": "string"
    },
    "last_message_sender": {
      "type": "string"
    }
  },
  "required": [
