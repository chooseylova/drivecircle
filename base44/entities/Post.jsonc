{
  "name": "Post",
  "type": "object",
  "properties": {
    "author_email": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar_url": {
      "type": "string",
      "default": ""
    },
    "content": {
      "type": "string"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "feed",
        "community"
      ],
      "default": "feed",
      "description": "feed = personal post for followers, community = public community post"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "dislikes_count": {
      "type": "number",
      "default": 0
    },
    "disliked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "author_email": {
            "type": "string"
          },
          "author_name": {
            "type": "string"
          },
          "author_avatar_url": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "created_date": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "shares_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "author_email",
    "content"
  ]
}